{
  "manifest_version": 2,
  "name": "DAB Media Sniffer",
  "description": "Captures media stream URLs observed by the browser so the built-in download manager can offer them.",
  "version": "1.16",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-sniffer@dab.browser",
      "strict_min_version": "112.0"
    }
  },
  "permissions": [
    "webRequest",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "*://*.googlevideo.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
